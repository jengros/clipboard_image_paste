<% cbp_text = ->(key) { l(key, default: I18n.t(key, locale: :en)) } %>
<div id="cbp_paste_dlg" title="<%= cbp_text.call(:cbp_txt_add_image) %>" style="display:none"
     data-add-label="<%= cbp_text.call(:cbp_txt_add_image) %>"
     data-ok-label="<%= cbp_text.call(:cbp_txt_btn_ok) %>"
     data-cancel-label="<%= cbp_text.call(:cbp_txt_btn_cancel) %>"
     data-print-message="<%= cbp_text.call(:cbp_txt_print) %>"
     data-select-message="<%= cbp_text.call(:cbp_txt_select) %>"
     data-no-image-message="<%= cbp_text.call(:cbp_txt_no_image_pst) %>"
     data-unsupported-message="<%= cbp_text.call(:cbp_txt_unsupported) %>"
     data-invalid-message="<%= cbp_text.call(:cbp_txt_invalid_image) %>"
     data-upload-failed-message="<%= cbp_text.call(:cbp_txt_upload_failed) %>"
     data-uploading-message="<%= cbp_text.call(:cbp_txt_uploading) %>">
  <p id="cbp_instructions" aria-live="polite"></p>
  <div id="cbp_panel_box" tabindex="0" role="region" aria-label="<%= cbp_text.call(:cbp_txt_add_image) %>"></div>
</div>
